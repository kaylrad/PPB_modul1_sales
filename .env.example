SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Alternatif demo publik: isi SUPABASE_KEY dengan anon key, kosongkan key di atas,
# lalu jalankan supabase/anon-demo.sql setelah supabase/schema.sql.
SUPABASE_KEY=
PORT=3000

# Opsional, hanya untuk pemasangan schema dan deployment melalui CLI/API.
# Token ini tidak dibutuhkan oleh aplikasi dan tidak boleh di-commit.
# SUPABASE_ACCESS_TOKEN=
# VERCEL_TOKEN=
